<Window xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpf="clr-namespace:Calcpad.Wpf"
    xmlns:me="clr-namespace:Calcpad.Wpf.MathEditor"
    xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Calcpad.Wpf.MainWindow"
    Title=" Hekatan Python3 — Python-syntax scientific worksheets"
    Height="800"
    Width="1200"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource ThemeWindowBg}"
    Icon="Resources/calcpad.ico"
    HorizontalContentAlignment="Center"
    WindowStyle="ThreeDBorderWindow" 
    Closing="Window_Closing"
    KeyUp="Window_KeyUp" 
    Unloaded="Window_Unloaded" 
    Loaded="Window_Loaded"
    Activated="Window_Activated" 
    ContentRendered="Window_ContentRendered">
    <Window.Resources>
        <!-- ============ TEMA (Dark por defecto; el toggle reasigna estos brushes) ============ -->
        <SolidColorBrush x:Key="ThemeWindowBg"    Color="#141109"/>
        <SolidColorBrush x:Key="ThemePanelBg"     Color="#1c1810"/>
        <SolidColorBrush x:Key="ThemeEditorBg"    Color="#1a1712"/>
        <SolidColorBrush x:Key="ThemeText"        Color="#E8E2D4"/>
        <SolidColorBrush x:Key="ThemeTextMuted"   Color="#A89F8C"/>
        <SolidColorBrush x:Key="ThemeAccentRed"   Color="#E5382B"/>
        <SolidColorBrush x:Key="ThemeAccentGold"  Color="#E6C463"/>
        <SolidColorBrush x:Key="ThemeButtonBg"    Color="#262016"/>
        <SolidColorBrush x:Key="ThemeButtonBorder" Color="#3A3226"/>
        <SolidColorBrush x:Key="ThemeGutterBg"    Color="#211D16"/>
        <SolidColorBrush x:Key="ThemeHoverBg"     Color="#33E5382B"/>
        <!-- Brushes de SISTEMA del menú (WPF/Aero los usa hardcodeados): barra + desplegables oscuros -->
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E8E2D4"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1C1810"/>
        <!-- ═══ Plantilla OSCURA del MenuItem: los desplegables ya no salen blancos ═══
             (Aero hardcodea el fondo del popup; hay que retemplar el MenuItem.) -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon"
                                                  VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" Margin="8,4,8,4"/>
                                <TextBlock x:Name="GestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource ThemeTextMuted}" Margin="20,4,8,4" VerticalAlignment="Center"/>
                                <Path x:Name="Arrow" Grid.Column="3" Data="M0,0 L4,4 L0,8 Z"
                                      Fill="{DynamicResource ThemeText}" VerticalAlignment="Center"
                                      Margin="4,0,8,0" Visibility="Collapsed"/>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom" PopupAnimation="None">
                                    <Border Background="{DynamicResource ThemePanelBg}"
                                            BorderBrush="{DynamicResource ThemeButtonBorder}" BorderThickness="1" Padding="2">
                                        <Grid IsSharedSizeScope="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                            </Trigger>
                            <!-- Items de la BARRA (nivel superior): compactos, sin gesto/flecha,
                                 para no crecer de alto ni chocar con la toolbar. -->
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="HeaderHost" Property="Margin" Value="7,1,7,1"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="HeaderHost" Property="Margin" Value="7,1,7,1"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Chrome text claro sobre oscuro (el editor usa Runs con color propio, no le afecta) -->
        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
        </Style>
        <!-- Tooltips oscuros para que sigan legibles -->
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorder}"/>
        </Style>
        <!-- Etiquetas de sección (Numbers:, Angles:, ...) y demás TextBlocks de chrome.
             El editor usa Runs con Foreground explícito, así que no le afecta. -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
        </Style>
        <!-- ComboBox: chrome claro por defecto → forzamos texto OSCURO (el TextBlock global
             claro lo volvería invisible). Legibles dentro de la UI oscura. -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#141109"/>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#141109"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Toggle" TargetType="{x:Type RadioButton}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
            <Setter Property="FontFamily" Value="Roboto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid x:Name="grid">
                            <Border x:Name="ButtonBorder" CornerRadius="3"
                                    BorderBrush="{DynamicResource ThemeButtonBorder}"
                                    BorderThickness="1" Padding="4,1,4,1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentGold}"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ThemeButtonBg}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentRed}"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="Roboto"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="grid">
                            <Border x:Name="ButtonBorder"
                                    CornerRadius="6"
                                    Background="{DynamicResource ThemeButtonBg}"
                                    BorderBrush="{DynamicResource ThemeButtonBorder}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentRed}"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormatButton" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontFamily" Value="Roboto"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="grid">
                            <Border x:Name="ButtonBorder" CornerRadius="3"
                                    Background="{DynamicResource ThemeButtonBg}"
                                    BorderBrush="{DynamicResource ThemeButtonBorder}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentRed}"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Menús desplegables (disp▾, graf▾) tematizados: fondo oscuro + texto claro + resalte oro.
             Theme-aware (DynamicResource) → correcto en dark Y en gold. Antes usaban el fondo blanco
             del sistema, ilegible en dark. -->
        <Style x:Key="ThemedMenuItem" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="mibd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="mibd" Property="Background" Value="{DynamicResource ThemeAccentGold}"/>
                                <Setter Property="Foreground" Value="#141109"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentGold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Tooltip tematizado para mostrar expresiones matemáticas renderizadas (∫, Σ, x², fracciones). -->
        <Style x:Key="MathTip" TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentGold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontFamily" Value="Cambria Math, Cambria, Georgia"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>
        <Style x:Key="ThemedContextMenu" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentGold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedMenuItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="3">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GreekLetter" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="14"/>
            <!-- Was "Times New Romans" (typo) — WPF couldn't resolve it and
                 fell back to a font without Unicode Greek glyphs, so the
                 letters in GreekLettersWarpPanel showed as boxes / blank. -->
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Background" Value="Bisque"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MarkdownCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#666"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C0E5382B"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#26E5382B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <RoutedUICommand x:Key="WebFormCommand" Text="Web Form" />
        <RoutedUICommand x:Key="CalculateCommand" Text="{x:Static wpf:MainWindowResources.Calculate}" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F4" Command="{StaticResource WebFormCommand}" />
        <KeyBinding Key="F5" Command="{StaticResource CalculateCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Executed="Command_WebForm" Command="{StaticResource WebFormCommand}"/>
        <CommandBinding Executed="Command_Calculate" Command="{StaticResource CalculateCommand}"/>
        <CommandBinding Executed="Command_New" Command="New"/>
        <CommandBinding Executed="Command_Open" Command="Open"/>
        <CommandBinding Executed="Command_Save" Command="Save"/>
        <CommandBinding Executed="Command_SaveAs" Command="SaveAs"/>
        <CommandBinding Executed="Command_Close" Command="Close"/>
        <CommandBinding Executed="Command_Help" Command="Help"/>
        <CommandBinding Executed="Command_Print" Command="Print"/>
        <CommandBinding Executed="Command_Find" Command="Find"/>
        <CommandBinding Executed="Command_Replace" Command="Replace"/>
        <CommandBinding Executed="Command_FindNext" Command="Search"/>
        <CommandBinding Executed="Command_Copy" Command="Copy"/>
        <CommandBinding Executed="Command_Paste" Command="Paste"/>
        <CommandBinding Executed="Command_Undo" Command="Undo"/>
        <CommandBinding Executed="Command_Redo" Command="Redo"/>
    </Window.CommandBindings>
    <Grid x:Name="MainGrid" MinWidth="1190" Background="{DynamicResource ThemeWindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu x:Name="MainMenu" VerticalAlignment="Top" Margin="2,2,2,0" Background="{x:Null}" Height="18"
              Foreground="{DynamicResource ThemeText}">
            <MenuItem Foreground="{DynamicResource ThemeText}">
                <MenuItem.Header>
                    <TextBlock Text="{x:Static wpf:MainWindowResources.File}" Foreground="{DynamicResource ThemeText}"/>
                </MenuItem.Header>
                <MenuItem Command="ApplicationCommands.New" 
                          Header="{x:Static wpf:MainWindowResources.New}"/>
                <MenuItem Command="ApplicationCommands.Open" 
                          Header="{x:Static wpf:MainWindowResources.Open}"/>
                <MenuItem x:Name="MenuRecent" 
                          Header="{x:Static wpf:MainWindowResources.RecentFiles}"/>
                <MenuItem x:Name="MenuSave" 
                          Command="ApplicationCommands.Save" 
                          Header="{x:Static wpf:MainWindowResources.Save}"/>
                <MenuItem Command="ApplicationCommands.SaveAs" 
                          Header="{x:Static wpf:MainWindowResources.SaveAs}"/>
                <MenuItem Click="MenuCli_Click"
                          Header="{x:Static wpf:MainWindowResources.CommandLineInterpreter}"/>
                <Separator/>
                <MenuItem x:Name="MenuExcelViewer" Header="Open Excel Viewer (.xlsx)"
                          Click="MenuExcelViewer_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuExportPlugin" Header="Export to MathCad Prime (.mcdx)"
                          Click="MenuExportPlugin_Click" Visibility="Collapsed"/>
                <MenuItem x:Name="MenuImportPlugin" Header="Import from MathCad Prime (.mcdx)"
                          Click="MenuImportPlugin_Click" Visibility="Collapsed"/>
                <Separator/>
                <MenuItem Command="ApplicationCommands.Close"
                          Header="{x:Static wpf:MainWindowResources.Exit}"/>
            </MenuItem>
            <MenuItem x:Name="MenuEdit" Foreground="{DynamicResource ThemeText}">
                <MenuItem.Header>
                    <TextBlock Text="{x:Static wpf:MainWindowResources.Edit}" Foreground="{DynamicResource ThemeText}"/>
                </MenuItem.Header>
                <MenuItem Command="ApplicationCommands.Find" 
                          Header="{x:Static wpf:MainWindowResources.Find}"/>
                <MenuItem Command="ApplicationCommands.Replace"
                          Header="{x:Static wpf:MainWindowResources.Replace}"/>
                <Separator/>
                <MenuItem Command="ApplicationCommands.Undo" 
                          Header="{x:Static wpf:MainWindowResources.Undo}"/>
                <MenuItem Command="ApplicationCommands.Redo" 
                          Header="{x:Static wpf:MainWindowResources.Redo}"/>
                <Separator/>
                <MenuItem Command="ApplicationCommands.Cut" 
                          Header="{x:Static wpf:MainWindowResources.Cut}"/>
                <MenuItem Command="ApplicationCommands.Copy" 
                          Header="{x:Static wpf:MainWindowResources.Copy}"/>
                <MenuItem Command="ApplicationCommands.Paste" 
                          Header="{x:Static wpf:MainWindowResources.Paste}"/>
                <Separator/>
                <MenuItem x:Name="PasteAsCommentMenu" InputGestureText="Ctrl+Shift+V" Click="PasteAsCommentMenu_Click"
                          Header="{x:Static wpf:MainWindowResources.PasteAsComment}"/>
                <MenuItem x:Name="CommentMenu"  InputGestureText="Ctrl+Q"
                          Header="{x:Static wpf:MainWindowResources.CommentSelectedLines}" Click="CommentMenu_Click"/>
                <MenuItem x:Name="UncommentMenu"  InputGestureText="Ctrl+Shift+Q"
                          Header="{x:Static wpf:MainWindowResources.UncommentSelectedLines}" Click="UncommentMenu_Click"/>
                <Separator/>
                <MenuItem Command="ApplicationCommands.SelectAll" 
                          Header="{x:Static wpf:MainWindowResources.Select_All}"/>
            </MenuItem>
            <MenuItem x:Name="MenuInsert" Foreground="{DynamicResource ThemeText}">
                <MenuItem.Header>
                    <TextBlock Text="{x:Static wpf:MainWindowResources.Insert}" Foreground="{DynamicResource ThemeText}"/>
                </MenuItem.Header>
                <!-- ============ Hekatan Python3: menu Insert en PYTHON (ni Calcpad ni MATLAB) ============
                     Cada Tag es lo que se ESCRIBE en el editor y el Header dice exactamente eso;
                     el ToolTip recuerda como se llamaba en MATLAB, para quien viene de alli.
                     Regla: nada de nombres pelados que Python no tenga (nthroot, strcat, isempty...):
                     lo vigila hekatan-py/tests/wpf/run_tests.py con la op "knows" del motor. -->
                <Separator/>
                <MenuItem Header="Comentarios / secciones">
                    <!-- VISIBLES en la hoja (llevan marcador) -->
                    <MenuItem Click="Button_Click" Tag="#' " Header="#'   texto VISIBLE" ToolTip="Texto de la hoja (markdown): SI sale en el reporte"/>
                    <MenuItem Click="Button_Click" Tag="#&quot; " Header="#&quot;   TITULO visible" ToolTip="Encabezado visible en el reporte"/>
                    <MenuItem Click="Button_Click" Tag="#noc " Header="#noc  formula tipografiada" ToolTip="Formula tipografiada dentro del comentario, visible en el reporte"/>
                    <MenuItem Click="Button_Click" Tag="#' **negrita**, _cursiva_, listas y tablas" Header="#'   markdown" ToolTip="En la linea #' vale markdown: **negrita**, _cursiva_, listas, tablas"/>
                    <MenuItem Click="Button_Click" Tag="#'-----" Header="#'-----  linea horizontal" ToolTip="Regla horizontal en la hoja"/>
                    <Separator/>
                    <!-- OCULTOS (no salen en la hoja) -->
                    <MenuItem Click="Button_Click" Tag="#%% " Header="#%%   celda (se pliega, NO sale)" ToolTip="Celda de codigo: se pliega en el editor y no sale en la hoja. Para titulo visible usa #&quot;"/>
                    <MenuItem Click="Button_Click" Tag="# " Header="#     comentario OCULTO" ToolTip="Comentario normal de Python: Hekatan Python3 NO lo muestra"/>
                    <MenuItem Click="Button_Click" Tag="#hide§§#show" Header="#hide ... #show" ToolTip="Ocultar (#hide) y volver a mostrar (#show) un bloque"/>
                    <MenuItem Click="Button_Click" Tag="'''§§'''" Header="''' ... '''  bloque que no se ejecuta" ToolTip="Cadena triple: en MATLAB era %{ ... %}"/>
                    <Separator/>
                    <MenuItem Click="Button_Click" Tag="#cp[§#' $k = EA/L$§#cp]" Header="#cp[ ... #cp]  formulas Calcpad" ToolTip="Bloque Calcpad embebido: formulas tipografiadas dentro del .py"/>
                    <MenuItem Click="Button_Click" Tag=" \" Header="\     continuar en la linea siguiente" ToolTip="Continuacion de linea (en MATLAB era ...)"/>
                </MenuItem>
                <MenuItem Header="{x:Static wpf:ConstantsResources.Constants_Header}">
                    <MenuItem Click="Button_Click" Tag="math.pi"  Header="math.pi"  ToolTip="3.14159..."/>
                    <MenuItem Click="Button_Click" Tag="math.e"   Header="math.e"   ToolTip="Numero de Euler"/>
                    <MenuItem Click="Button_Click" Tag="math.tau" Header="math.tau" ToolTip="2*pi"/>
                    <MenuItem Click="Button_Click" Tag="math.inf" Header="math.inf" ToolTip="Infinito (en MATLAB: Inf)"/>
                    <MenuItem Click="Button_Click" Tag="math.nan" Header="math.nan" ToolTip="No es un numero (en MATLAB: NaN)"/>
                    <MenuItem Click="Button_Click" Tag="np.finfo(float).eps" Header="np.finfo(float).eps" ToolTip="Epsilon de maquina (en MATLAB: eps)"/>
                    <MenuItem Click="Button_Click" Tag="1j" Header="1j    unidad imaginaria" ToolTip="En MATLAB: i"/>
                    <Separator/>
                    <MenuItem Click="Button_Click" Tag="True"  Header="True"  ToolTip="Verdadero (en MATLAB: true)"/>
                    <MenuItem Click="Button_Click" Tag="False" Header="False" ToolTip="Falso (en MATLAB: false)"/>
                    <MenuItem Click="Button_Click" Tag="None"  Header="None"  ToolTip="Nada / vacio"/>
                </MenuItem>
                <MenuItem Header="{x:Static wpf:MathResources.Operators}">
                    <MenuItem Header="Aritmeticos">
                        <MenuItem Click="Button_Click" Tag="+"  Header="+     suma"/>
                        <MenuItem Click="Button_Click" Tag="-"  Header="-     resta"/>
                        <MenuItem Click="Button_Click" Tag="*"  Header="*     multiplicacion"/>
