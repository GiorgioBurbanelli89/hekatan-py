                <Grid Background="{DynamicResource ThemePanelBg}">
                    <Wpf:WebView2 x:Name="WebViewer" Margin="5,5,5,5" KeyUp="WebViewer_KeyUp" PreviewKeyDown="WebViewer_PreviewKeyDown" NavigationCompleted="WebViewer_NavigationCompleted" WebMessageReceived="WebViewer_WebMessageReceived" />
                    <me:MathCanvasControl x:Name="MathCanvasView" Visibility="Collapsed" Margin="5,5,5,5"/>
                </Grid>
            </GroupBox>
            <GridSplitter x:Name="MainSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Margin="1,5,1,0" Background="#32DDDDDD" />
            <Border x:Name="CodeCheckBorder"
                    CornerRadius="4" Padding="4,2,2,2" Margin="0,2,16,0" 
                    HorizontalAlignment="Right" VerticalAlignment="Top"  
                    Width="120" Height="20"
                    Grid.Column="2" Visibility="Hidden">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.8">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <CheckBox x:Name="CodeCheckBox" 
                    Content="{x:Static wpf:MainWindowResources.UnwrappedCode}" 
                    ToolTip="{x:Static wpf:MainWindowResources.ShowUnwrappedSourceCodeInTheOutputWhenMacrosOrIncludesAreAvailable}" 
                    TabIndex="22" Click="CodeCheckBox_Click" FontFamily="Segoe UI Semibold" >
                </CheckBox>
            </Border>
        </Grid>
        <TextBlock Grid.Row="0" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12.5" Margin="0,28,155,0" Height="16"
            VerticalAlignment="Top"  HorizontalAlignment="Right" Width="50"
            Text="(5-100)" />
            <!-- Ajustes del plotter de CALCPAD. Solo tienen efecto dentro de un bloque #cp[ ... #cp];
             las graficas de Python las hace el motor (plot, mesh_viewer, solid3d_viewer), que no
             los mira. Se quedan aqui, ocultos, para no ensuciar la barra: el codigo los sigue
             leyendo y guardando igual. Poner Visibility="Visible" para sacarlos. -->
        <StackPanel x:Name="PlotSettingsPanel" Grid.Row="1" Visibility="Collapsed">
            <CheckBox x:Name="AdaptiveCheckBox" IsChecked="True" Click="AdaptiveCheckBox_Click"/>
            <CheckBox x:Name="ShadowsCheckBox" Click="ShadowsCheckBox_Click"/>
            <CheckBox x:Name="SmoothCheckBox" Click="SmoothCheckBox_Click"/>
            <CheckBox x:Name="EmbedCheckBox" IsChecked="True" Click="EmbedCheckBox_Click"/>
            <ComboBox x:Name="LightDirectionComboBox" SelectionChanged="LightDirectionComboBox_SelectionChanged">
                <ComboBoxItem Content="North"/><ComboBoxItem Content="NorthEast"/><ComboBoxItem Content="East"/>
                <ComboBoxItem Content="SouthEast"/><ComboBoxItem Content="South"/><ComboBoxItem Content="SouthWest"/>
                <ComboBoxItem Content="West"/><ComboBoxItem Content="NorthWest" IsSelected="True"/>
            </ComboBox>
            <ComboBox x:Name="ColorScaleComboBox" SelectionChanged="ColorScaleComboBox_SelectionChanged">
                <ComboBoxItem Content="None"/><ComboBoxItem Content="Gray"/>
                <ComboBoxItem Content="Rainbow" IsSelected="True"/><ComboBoxItem Content="Terrain"/>
                <ComboBoxItem Content="VioletToYellow"/><ComboBoxItem Content="GreenToYellow"/>
                <ComboBoxItem Content="Blue"/>
            </ComboBox>
        </StackPanel>
</Grid>
</Window>
